{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "听境",
  "version": "0.1.1",
  "identifier": "space.tingjing.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "听境",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data: https://*.qq.com https://*.qlogo.cn https://*.qqmusic.qq.com https://*.music.126.net https://*.scdn.co https://*.spotifycdn.com",
        "media-src": "'self' blob: https://*.qq.com https://*.qqmusic.qq.com https://*.music.126.net https://*.scdn.co https://*.spotifycdn.com",
        "connect-src": "ipc: http://ipc.localhost https://*.qq.com https://*.qqmusic.qq.com https://*.music.126.net https://*.scdn.co https://*.spotifycdn.com",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'",
        "form-action": "'none'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
