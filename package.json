{
  "name": "inside-the-song",
  "private": true,
  "version": "0.1.1",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/March7th2333/Tingjing",
  "repository": {
    "type": "git",
    "url": "https://github.com/March7th2333/Tingjing.git"
  },
  "bugs": {
    "url": "https://github.com/March7th2333/Tingjing/issues"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "lint": "eslint src --max-warnings=0",
    "test": "npm run test:i18n && node --test tests/spotifyProvider.test.ts && npm run test:lyrics && npm run test:requests && npm run test:audio-analysis && npm run test:typography && npm run test:player-foundation && node --test tests/playbackReturn.test.ts tests/dailyListeningStore.test.ts tests/qrPollingPolicy.test.ts tests/welcomeSession.test.ts",
    "test:qq-lyrics": "node --test tests/qqLyrics.test.ts",
    "test:netease-lyrics": "node --test tests/neteaseLyrics.test.ts",
    "test:spotify": "node --test tests/spotifyProvider.test.ts tests/welcomeSession.test.ts tests/playbackQueue.test.ts tests/playbackSessionStore.test.ts",
    "test:imprint": "node --test tests/imprintTimeline.test.ts",
    "test:typography": "node --test tests/typographyScenePlanner.test.ts tests/typographyContinuity.test.ts",
    "test:audio-analysis": "node scripts/runAudioAnalysisTests.mjs",
    "test:lyrics": "node --test tests/lyricTruth.test.ts tests/lyricUnitTiming.test.ts && npm run test:imprint && npm run test:qq-lyrics && npm run test:netease-lyrics",
    "test:requests": "node --test tests/providerRequestCoordinator.test.ts tests/playbackPrefetch.test.ts",
    "test:player-foundation": "node --test tests/playbackQueue.test.ts tests/playerPreferences.test.ts tests/playbackVolume.test.ts tests/playbackSessionStore.test.ts tests/webMediaSession.test.ts",
    "test:i18n": "node --test tests/i18n.test.ts",
    "build": "tsc -b && vite build",
    "release:verify": "node scripts/release/verifyReleaseVersion.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "qrc-decoder": "^1.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.15.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.3"
  }
}
